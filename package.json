{
  "name": "app-estudos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mesa local de estudos — MVP alpha",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/start.mjs --dev",
    "start": "node scripts/start.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "test:journey": "tsx scripts/smoke-journey.ts",
    "test:engine-explorer": "tsx scripts/smoke-engine-explorer.ts",
    "test:game": "tsx scripts/smoke-game.ts --packaged",
    "package:win": "npm run build && electron-builder --win --dir",
    "check:docs": "node scripts/check-bootstrap.mjs",
    "test:smooth-ui": "tsx scripts/smoke-smooth-ui.ts --packaged",
    "test:videos": "tsx scripts/smoke-videos.ts --packaged",
    "test:settings": "tsx scripts/smoke-settings.ts",
    "test:pdf-export": "tsx scripts/smoke-pdf-export.ts",
    "test:expansion": "tsx scripts/smoke-expansion.ts",
    "test:annotations": "tsx scripts/smoke-annotations.ts",
    "test:knowledge-backup": "tsx scripts/smoke-knowledge-backup.ts",
    "test:editorial": "tsx scripts/smoke-editorial.ts --packaged",
    "test:city-progression": "tsx scripts/smoke-city-progression.ts --packaged",
    "test:clean-workspace": "tsx scripts/smoke-clean-workspace.ts",
    "test:study-tabs": "tsx scripts/smoke-study-tabs.ts",
    "test:deep-economy": "tsx scripts/smoke-deep-economy.ts --packaged",
    "simulate:economy": "tsx scripts/simulate-economy.ts",
    "simulate:farm": "tsx scripts/simulate-farm.ts",
    "test:farm": "tsx scripts/smoke-farm.ts"
  },
  "build": {
    "appId": "local.appestudos.desktop",
    "productName": "App Estudos",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "decimal.js": "10.6.0",
    "gsap": "3.15.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.1",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
