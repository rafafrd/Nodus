* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.zip binary
*.ico binary
*.webm binary

# Preserve raw validation artifacts and their manifest hashes across platforms.
docs/validation/evidence/notes-ux/** -text
docs/validation/evidence/farm-projects/** -text
docs/validation/evidence/visual-experience/** -text
docs/validation/evidence/home-white/** -text
# Logs retain whitespace emitted by tools rather than changing the evidence.
docs/validation/evidence/**/*.log whitespace=-blank-at-eol,-blank-at-eof
docs/validation/evidence/notes-ux/unit-final.txt whitespace=cr-at-eol
